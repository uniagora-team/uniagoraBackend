# UniAGORA backend environment template.
# Copy to .env and fill in real values. Never commit .env.

# Django core
SECRET_KEY=change-me
DEBUG=true

# PostgreSQL
DB_NAME=uniagora
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Channels (websocket layer)
REDIS_URL=redis://localhost:6379

# Cloudinary (media storage: product images, vendor logos/documents,
# university logos, chat attachments)
# Dashboard -> Programmable Media -> Product environment credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
